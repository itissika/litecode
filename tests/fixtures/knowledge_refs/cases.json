{
  "version": 3,
  "about": "Contract table for workspace citations (standard CommonMark Markdown links). Rust runs it in src/knowledge/spec_tests.rs; the frontend runs the same table in web/src/lib/knowledge/contract.test.ts. extract: citations in document order with syntax-derived ref_key (path:<path>, sym:<path>\\0<symbol>, range:<path>\\0<lines>). resolve: expect lists every issue as {node, status, ref_key} for citation issues or {node, status, ref} for declaration issues. layout: folder tree and unknown files.",
  "extract": [
    {
      "id": "link.basic_file",
      "rule": "KR-SYN-1",
      "text": "see [a.rs](src/a.rs)",
      "refs": [
        {
          "kind": "file",
          "path": "src/a.rs",
          "ref_key": "path:src/a.rs"
        }
      ]
    },
    {
      "id": "link.knowledge_node_path",
      "rule": "KR-SYN-1",
      "text": "see [seq](knowledge/contracts/seq.md)",
      "refs": [
        {
          "kind": "file",
          "path": "knowledge/contracts/seq.md",
          "ref_key": "path:knowledge/contracts/seq.md"
        }
      ]
    },
    {
      "id": "link.angle_brackets_and_percent_spaces",
      "rule": "KR-SYN-1",
      "text": "[doc](<文档/设计 说明.md>) [enc](knowledge/knowledge%20概念.md)",
      "refs": [
        {
          "kind": "file",
          "path": "文档/设计 说明.md",
          "ref_key": "path:文档/设计 说明.md"
        },
        {
          "kind": "file",
          "path": "knowledge/knowledge 概念.md",
          "ref_key": "path:knowledge/knowledge 概念.md"
        }
      ]
    },
    {
      "id": "link.dynamic_route_brackets",
      "rule": "KR-SYN-1",
      "text": "[page](src/app/[id]/page.tsx#L5)",
      "refs": [
        {
          "kind": "range",
          "path": "src/app/[id]/page.tsx",
          "lines": "5",
          "ref_key": "range:src/app/[id]/page.tsx\u00005"
        }
      ]
    },
    {
      "id": "link.web_anchors_and_images_ignored",
      "rule": "KR-SYN-2",
      "text": "[web](https://example.com) [mail](mailto:a@b.com) [proto](//cdn.example.com/a.js) [sec](#overview) ![pic](assets/a.png) [empty]()",
      "refs": []
    },
    {
      "id": "legacy.shortcodes_are_plain_text",
      "rule": "KR-SYN-7",
      "text": "[[node : seq]] [@ key=\"seq\"] [@ file=\"src/a.rs\"] [@ file=\"src/a.rs\" lines=\"4-9\"] [@src/a.rs]",
      "refs": []
    },
    {
      "id": "link.empty_fragment_is_file",
      "rule": "KR-SYN-3",
      "text": "[a](src/a.rs#)",
      "refs": [
        {
          "kind": "file",
          "path": "src/a.rs",
          "ref_key": "path:src/a.rs"
        }
      ]
    },
    {
      "id": "symbol.dot_and_double_colon",
      "rule": "KR-SYN-4",
      "text": "[save](src/a.rs#Store.save) [rust](src/a.rs#Store::save) [leaf](src/a.rs#resolve)",
      "refs": [
        {
          "kind": "symbol",
          "path": "src/a.rs",
          "symbol": "Store.save",
          "ref_key": "sym:src/a.rs\u0000Store.save"
        },
        {
          "kind": "symbol",
          "path": "src/a.rs",
          "symbol": "Store.save",
          "ref_key": "sym:src/a.rs\u0000Store.save"
        },
        {
          "kind": "symbol",
          "path": "src/a.rs",
          "symbol": "resolve",
          "ref_key": "sym:src/a.rs\u0000resolve"
        }
      ]
    },
    {
      "id": "range.valid_forms",
      "rule": "KR-SYN-5",
      "text": "[a](src/a.rs#L4) [b](src/a.rs#L4-4) [c](src/a.rs#L4-L4) [d](src/a.rs#L4-9) [e](src/a.rs#L4-L9)",
      "refs": [
        {
          "kind": "range",
          "path": "src/a.rs",
          "lines": "4",
          "ref_key": "range:src/a.rs\u00004"
        },
        {
          "kind": "range",
          "path": "src/a.rs",
          "lines": "4",
          "ref_key": "range:src/a.rs\u00004"
        },
        {
          "kind": "range",
          "path": "src/a.rs",
          "lines": "4",
          "ref_key": "range:src/a.rs\u00004"
        },
        {
          "kind": "range",
          "path": "src/a.rs",
          "lines": "4-9",
          "ref_key": "range:src/a.rs\u00004-9"
        },
        {
          "kind": "range",
          "path": "src/a.rs",
          "lines": "4-9",
          "ref_key": "range:src/a.rs\u00004-9"
        }
      ]
    },
    {
      "id": "range.invalid_lines_kept",
      "rule": "KR-SYN-5",
      "text": "[a](a.rs#L0-1) [b](b.rs#L9-4) [c](c.rs#12) [d](d.rs#12-30) [e](e.rs#L04) [f](f.rs#L1-) [g](g.rs#L-3) [h](h.rs#L0) [i](i.rs#L+3) [j](j.rs#L1-2-3) [k](k.rs#L３)",
      "refs": [
        {
          "kind": "range",
          "path": "a.rs",
          "lines": null,
          "bad_lines": "L0-1",
          "ref_key": "range:a.rs\u0000L0-1"
        },
        {
          "kind": "range",
          "path": "b.rs",
          "lines": null,
          "bad_lines": "L9-4",
          "ref_key": "range:b.rs\u0000L9-4"
        },
        {
          "kind": "range",
          "path": "c.rs",
          "lines": null,
          "bad_lines": "12",
          "ref_key": "range:c.rs\u000012"
        },
        {
          "kind": "range",
          "path": "d.rs",
          "lines": null,
          "bad_lines": "12-30",
          "ref_key": "range:d.rs\u000012-30"
        },
        {
          "kind": "range",
          "path": "e.rs",
          "lines": null,
          "bad_lines": "L04",
          "ref_key": "range:e.rs\u0000L04"
        },
        {
          "kind": "range",
          "path": "f.rs",
          "lines": null,
          "bad_lines": "L1-",
          "ref_key": "range:f.rs\u0000L1-"
        },
        {
          "kind": "range",
          "path": "g.rs",
          "lines": null,
          "bad_lines": "L-3",
          "ref_key": "range:g.rs\u0000L-3"
        },
        {
          "kind": "range",
          "path": "h.rs",
          "lines": null,
          "bad_lines": "L0",
          "ref_key": "range:h.rs\u0000L0"
        },
        {
          "kind": "range",
          "path": "i.rs",
          "lines": null,
          "bad_lines": "L+3",
          "ref_key": "range:i.rs\u0000L+3"
        },
        {
          "kind": "range",
          "path": "j.rs",
          "lines": null,
          "bad_lines": "L1-2-3",
          "ref_key": "range:j.rs\u0000L1-2-3"
        },
        {
          "kind": "range",
          "path": "k.rs",
          "lines": null,
          "bad_lines": "L３",
          "ref_key": "range:k.rs\u0000L３"
        }
      ]
    },
    {
      "id": "range.overflow_is_invalid",
      "rule": "KR-SYN-5",
      "text": "[a](a.rs#L4294967296)",
      "refs": [
        {
          "kind": "range",
          "path": "a.rs",
          "lines": null,
          "bad_lines": "L4294967296",
          "ref_key": "range:a.rs\u0000L4294967296"
        }
      ]
    },
    {
      "id": "range.u32_max_is_valid",
      "rule": "KR-SYN-5",
      "text": "[a](a.rs#L4294967295)",
      "refs": [
        {
          "kind": "range",
          "path": "a.rs",
          "lines": "4294967295",
          "ref_key": "range:a.rs\u00004294967295"
        }
      ]
    },
    {
      "id": "code.fences_hidden",
      "rule": "KR-SYN-6",
      "text": "```\n[a](knowledge/a.md)\n```\n~~~\n[b](knowledge/b.md)\n~~~\n````\n```\n[c](knowledge/c.md)\n````\n[d](knowledge/d.md)",
      "refs": [
        {
          "kind": "file",
          "path": "knowledge/d.md",
          "ref_key": "path:knowledge/d.md"
        }
      ]
    },
    {
      "id": "code.indented_four_is_not_a_fence",
      "rule": "KR-SYN-6",
      "text": "    ```\n[a](knowledge/a.md)",
      "refs": [
        {
          "kind": "file",
          "path": "knowledge/a.md",
          "ref_key": "path:knowledge/a.md"
        }
      ]
    },
    {
      "id": "code.unclosed_fence_hides_rest",
      "rule": "KR-SYN-6",
      "text": "[a](knowledge/a.md)\n```\n[b](knowledge/b.md)",
      "refs": [
        {
          "kind": "file",
          "path": "knowledge/a.md",
          "ref_key": "path:knowledge/a.md"
        }
      ]
    },
    {
      "id": "code.inline_hidden",
      "rule": "KR-SYN-6",
      "text": "`[a](knowledge/a.md)` ``x [b](knowledge/b.md) y`` [`c`](knowledge/c.md)",
      "refs": [
        {
          "kind": "file",
          "path": "knowledge/c.md",
          "ref_key": "path:knowledge/c.md"
        }
      ]
    },
    {
      "id": "code.unclosed_backtick_is_prose",
      "rule": "KR-SYN-6",
      "text": "` [a](knowledge/a.md)",
      "refs": [
        {
          "kind": "file",
          "path": "knowledge/a.md",
          "ref_key": "path:knowledge/a.md"
        }
      ]
    },
    {
      "id": "order.mixed_and_repeats",
      "rule": "KR-SYN-8",
      "text": "[b](b.rs) then [x](knowledge/x.md) and [a](a.rs#a)\n[x](knowledge/x.md)",
      "refs": [
        {
          "kind": "file",
          "path": "b.rs",
          "ref_key": "path:b.rs"
        },
        {
          "kind": "file",
          "path": "knowledge/x.md",
          "ref_key": "path:knowledge/x.md"
        },
        {
          "kind": "symbol",
          "path": "a.rs",
          "symbol": "a",
          "ref_key": "sym:a.rs\u0000a"
        },
        {
          "kind": "file",
          "path": "knowledge/x.md",
          "ref_key": "path:knowledge/x.md"
        }
      ]
    },
    {
      "id": "ref_key.path_normalized",
      "rule": "KR-KEY-1",
      "text": "[a](< src\\a.rs >) [s](src\\a.rs#S::x) [r](src\\a.rs#L7-L7)",
      "refs": [
        {
          "kind": "file",
          "path": "src/a.rs",
          "ref_key": "path:src/a.rs"
        },
        {
          "kind": "symbol",
          "path": "src/a.rs",
          "symbol": "S.x",
          "ref_key": "sym:src/a.rs\u0000S.x"
        },
        {
          "kind": "range",
          "path": "src/a.rs",
          "lines": "7",
          "ref_key": "range:src/a.rs\u00007"
        }
      ]
    }
  ],
  "resolve": [
    {
      "id": "node.ok",
      "rule": "KR-NODE-1",
      "nodes": [
        {
          "key": "a",
          "body": "[b](knowledge/sub/b.md)"
        },
        {
          "key": "b",
          "path": "sub/b.md",
          "body": ""
        }
      ],
      "expect": []
    },
    {
      "id": "node.missing_path",
      "rule": "KR-NODE-1",
      "nodes": [
        {
          "key": "a",
          "body": "[gone](knowledge/gone.md) [gone](knowledge/gone.md)"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:knowledge/gone.md"
        }
      ]
    },
    {
      "id": "node.case_sensitive",
      "rule": "KR-NODE-1",
      "nodes": [
        {
          "key": "a",
          "body": "[Seq](knowledge/Seq.md)"
        },
        {
          "key": "seq",
          "body": ""
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:knowledge/Seq.md"
        }
      ]
    },
    {
      "id": "node.self",
      "rule": "KR-NODE-2",
      "nodes": [
        {
          "key": "a",
          "body": "[a](knowledge/a.md)"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "self_relation",
          "ref_key": "path:knowledge/a.md"
        }
      ]
    },
    {
      "id": "node.inactive_target",
      "rule": "KR-NODE-3",
      "nodes": [
        {
          "key": "a",
          "body": "[off](knowledge/off.md) [draft](knowledge/draft.md)"
        },
        {
          "key": "off",
          "status": "disabled",
          "body": ""
        },
        {
          "key": "draft",
          "status": "pending",
          "body": ""
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "inactive_target",
          "ref_key": "path:knowledge/off.md"
        },
        {
          "node": "a.md",
          "status": "inactive_target",
          "ref_key": "path:knowledge/draft.md"
        }
      ]
    },
    {
      "id": "node.inactive_citer_is_quiet",
      "rule": "KR-NODE-3",
      "nodes": [
        {
          "key": "a",
          "status": "disabled",
          "body": "[off](knowledge/off.md)"
        },
        {
          "key": "p",
          "status": "pending",
          "body": "[off](knowledge/off.md)"
        },
        {
          "key": "off",
          "status": "disabled",
          "body": ""
        }
      ],
      "expect": []
    },
    {
      "id": "node.bad_filename_mismatch_is_unciteable",
      "rule": "KR-DECL-1",
      "nodes": [
        {
          "key": "right",
          "path": "wrong.md",
          "body": ""
        },
        {
          "key": "a",
          "body": "[wrong](knowledge/wrong.md)"
        }
      ],
      "expect": [
        {
          "node": "wrong.md",
          "status": "filename_mismatch",
          "ref": "right"
        },
        {
          "node": "a.md",
          "status": "dangling_relation",
          "ref_key": "path:knowledge/wrong.md"
        }
      ]
    },
    {
      "id": "node.plain_md_under_knowledge_is_file_ok",
      "rule": "KR-NODE-1",
      "files": {
        "knowledge/readme.md": "# Plain notes without node fence\n"
      },
      "nodes": [
        {
          "key": "a",
          "body": "[readme](knowledge/readme.md)"
        }
      ],
      "expect": []
    },
    {
      "id": "node.line_range_on_knowledge_node_is_range_ok",
      "rule": "KR-RANGE-2",
      "nodes": [
        {
          "key": "a",
          "body": "[b:1](knowledge/b.md#L1)"
        },
        {
          "key": "b",
          "body": "hello"
        }
      ],
      "expect": []
    },
    {
      "id": "node.code_is_not_a_citation",
      "rule": "KR-SYN-6",
      "nodes": [
        {
          "key": "a",
          "body": "```\n[gone](knowledge/gone.md)\n```\n`[nope](nope.rs)`"
        }
      ],
      "expect": []
    },
    {
      "id": "node.duplicate_key_flagged_on_both",
      "rule": "KR-NODE-4",
      "nodes": [
        {
          "key": "dup",
          "path": "x/dup.md",
          "body": ""
        },
        {
          "key": "dup",
          "path": "y/dup.md",
          "body": ""
        },
        {
          "key": "c",
          "body": "[dup](knowledge/x/dup.md)"
        }
      ],
      "expect": [
        {
          "node": "x/dup.md",
          "status": "duplicate_key",
          "ref": "dup"
        },
        {
          "node": "y/dup.md",
          "status": "duplicate_key",
          "ref": "dup"
        }
      ]
    },
    {
      "id": "file.ok",
      "rule": "KR-PATH-3",
      "files": {
        "src/a.rs": "fn alpha() {}\n"
      },
      "nodes": [
        {
          "key": "a",
          "body": "[a.rs](src/a.rs) [a.rs](src/a.rs)"
        }
      ],
      "expect": []
    },
    {
      "id": "file.directory_ok",
      "rule": "KR-PATH-3",
      "files": {
        "src/a.rs": ""
      },
      "dirs": [
        "empty"
      ],
      "nodes": [
        {
          "key": "a",
          "body": "[src](src) [empty](empty)"
        }
      ],
      "expect": []
    },
    {
      "id": "file.missing",
      "rule": "KR-PATH-3",
      "nodes": [
        {
          "key": "a",
          "body": "[gone](src/gone.rs) [gone](src/gone.rs)"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:src/gone.rs"
        }
      ]
    },
    {
      "id": "file.illegal_paths",
      "rule": "KR-PATH-1",
      "files": {
        "src/a.rs": ""
      },
      "nodes": [
        {
          "key": "a",
          "body": "[1](../x) [2](/etc/passwd) [3](C:/x) [4](src/../src/a.rs) [5](./src/a.rs) [6](src//a.rs) [7](src/)"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:../x"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:/etc/passwd"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:C:/x"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:src/../src/a.rs"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:./src/a.rs"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:src//a.rs"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:src/"
        }
      ]
    },
    {
      "id": "file.backslash_normalized",
      "rule": "KR-PATH-2",
      "files": {
        "src/a.rs": ""
      },
      "nodes": [
        {
          "key": "a",
          "body": "[a](src\\a.rs)"
        }
      ],
      "expect": []
    },
    {
      "id": "file.gitignored_and_dotfiles_exist",
      "rule": "KR-PATH-3",
      "files": {
        ".gitignore": "ignored/\n",
        "ignored/x.txt": "x",
        ".env": "A=1",
        ".config/x.toml": ""
      },
      "nodes": [
        {
          "key": "a",
          "body": "[x](ignored/x.txt) [env](.env) [cfg](.config/x.toml)"
        }
      ],
      "expect": []
    },
    {
      "id": "file.unicode_and_spaces",
      "rule": "KR-PATH-3",
      "files": {
        "文档/设计 说明.md": "x"
      },
      "nodes": [
        {
          "key": "a",
          "body": "[doc](<文档/设计 说明.md>)"
        }
      ],
      "expect": []
    },
    {
      "id": "file.case_and_trailing_dot_mismatch",
      "rule": "KR-PATH-4",
      "files": {
        "src/a.rs": ""
      },
      "nodes": [
        {
          "key": "a",
          "body": "[1](SRC/a.rs) [2](src/A.rs) [3](src/a.rs.) [4](src./a.rs)"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:SRC/a.rs"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:src/A.rs"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:src/a.rs."
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "path:src./a.rs"
        }
      ]
    },
    {
      "id": "symbol.ok_and_struct_impl_prefers_def",
      "rule": "KR-SYM-2",
      "files": {
        "src/a.rs": "struct Store;\nimpl Store {\n    pub fn save(&self) {}\n}\nfn alpha() {}\n"
      },
      "nodes": [
        {
          "key": "a",
          "body": "[alpha](src/a.rs#alpha) [Store](src/a.rs#Store) [save](src/a.rs#Store.save) [save2](src/a.rs#Store::save) [leaf](src/a.rs#save)"
        }
      ],
      "expect": []
    },
    {
      "id": "symbol.missing",
      "rule": "KR-SYM-2",
      "files": {
        "src/a.rs": "fn alpha() {}\n"
      },
      "nodes": [
        {
          "key": "a",
          "body": "[beta](src/a.rs#beta) [Alpha](src/a.rs#Alpha)"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "missing_symbol",
          "ref_key": "sym:src/a.rs\u0000beta"
        },
        {
          "node": "a.md",
          "status": "missing_symbol",
          "ref_key": "sym:src/a.rs\u0000Alpha"
        }
      ]
    },
    {
      "id": "symbol.ambiguous_and_disambiguated",
      "rule": "KR-SYM-3",
      "files": {
        "src/a.rs": "struct A;\nimpl A { fn new() {} }\nstruct B;\nimpl B { fn new() {} }\n"
      },
      "nodes": [
        {
          "key": "a",
