{
  "version": 2,
  "spec": "docs/knowledge-references.md",
  "about": "Contract table for knowledge references. Rust runs it in src/knowledge/spec_tests.rs; the frontend can run the same table. extract: refs in document order, each with kind, its fields and ref_key (docs §1.1). resolve: expect lists every issue as {node: node path relative to the knowledge root, status, ref_key} for citation issues or {node, status, ref} for declaration issues. layout: folder tree and unknown files. `divergence` marks a case the backend does not follow yet (none today). `frontend` names a frontend divergence F1-F7 (documentation only).",
  "extract": [
    {
      "id": "node.basic",
      "rule": "KR-SYN-1",
      "text": "see [@ key=\"seq\"]",
      "refs": [
        {
          "kind": "node",
          "key": "seq",
          "ref_key": "node:seq"
        }
      ]
    },
    {
      "id": "node.key_trimmed",
      "rule": "KR-SYN-1",
      "text": "[@ key=\" seq \"]",
      "refs": [
        {
          "kind": "node",
          "key": "seq",
          "ref_key": "node:seq"
        }
      ]
    },
    {
      "id": "node.key_spaced_cjk",
      "rule": "KR-SYN-1",
      "text": "[@ key=\"knowledge 概念\"]",
      "refs": [
        {
          "kind": "node",
          "key": "knowledge 概念",
          "ref_key": "node:knowledge 概念"
        }
      ]
    },
    {
      "id": "node.key_double_space_is_text",
      "rule": "KR-SYN-1",
      "text": "[@ key=\"a  b\"]",
      "refs": []
    },
    {
      "id": "node.key_bracket_is_text",
      "rule": "KR-SYN-1",
      "text": "[@ key=\"a]b\"]",
      "refs": []
    },
    {
      "id": "node.no_space_is_text",
      "rule": "KR-SYN-2",
      "text": "[@key=\"seq\"]",
      "refs": []
    },
    {
      "id": "unknown_attribute_is_text",
      "rule": "KR-SYN-2",
      "text": "[@ key=\"seq\" label=\"x\"] [@ file=\"src/a.rs\" label=\"a\"] [@ id=\"seq\"]",
      "refs": []
    },
    {
      "id": "attribute_order_is_fixed",
      "rule": "KR-SYN-2",
      "text": "[@ lines=\"1\" file=\"src/a.rs\"] [@ file=\"src/a.rs\" lines=\"1\" symbol=\"fn a\"]",
      "refs": []
    },
    {
      "id": "legacy_marker_is_text",
      "rule": "KR-SYN-7",
      "text": "[[node : seq]]",
      "refs": []
    },
    {
      "id": "file.basic",
      "rule": "KR-SYN-3",
      "text": "[@ file=\"src/a.rs\"]",
      "refs": [
        {
          "kind": "file",
          "path": "src/a.rs",
          "ref_key": "file:src/a.rs"
        }
      ]
    },
    {
      "id": "file.trimmed",
      "rule": "KR-SYN-3",
      "text": "[@ file=\" src/a.rs \"]",
      "refs": [
        {
          "kind": "file",
          "path": "src/a.rs",
          "ref_key": "file:src/a.rs"
        }
      ]
    },
    {
      "id": "file.empty_is_text",
      "rule": "KR-SYN-3",
      "text": "[@ file=\"\"] [@ file=\"   \"]",
      "refs": []
    },
    {
      "id": "file.empty_symbol_is_file",
      "rule": "KR-SYN-4",
      "text": "[@ file=\"src/a.rs\" symbol=\"\"]",
      "refs": [
        {
          "kind": "file",
          "path": "src/a.rs",
          "ref_key": "file:src/a.rs"
        }
      ]
    },
    {
      "id": "symbol.chain",
      "rule": "KR-SYN-4",
      "text": "[@ file=\"src/a.rs\" symbol=\"impl Store › fn save\"]",
      "refs": [
        {
          "kind": "symbol",
          "path": "src/a.rs",
          "symbol": "impl Store › fn save",
          "lines": null,
          "ref_key": "sym:src/a.rs\u0000impl Store › fn save"
        }
      ]
    },
    {
      "id": "symbol.chain_trimmed",
      "rule": "KR-SYN-4",
      "text": "[@ file=\"src/a.rs\" symbol=\"  fn alpha \"]",
      "refs": [
        {
          "kind": "symbol",
          "path": "src/a.rs",
          "symbol": "fn alpha",
          "lines": null,
          "ref_key": "sym:src/a.rs\u0000fn alpha"
        }
      ]
    },
    {
      "id": "symbol.lines_are_not_a_span",
      "rule": "KR-SYM-6",
      "text": "[@ file=\"src/a.rs\" symbol=\"fn alpha\" lines=\"2148-2165\"] [@ file=\"src/a.rs\" symbol=\"fn alpha\"]",
      "refs": [
        {
          "kind": "symbol",
          "path": "src/a.rs",
          "symbol": "fn alpha",
          "lines": null,
          "bad_lines": "2148-2165",
          "ref_key": "sym:src/a.rs\u0000fn alpha"
        },
        {
          "kind": "symbol",
          "path": "src/a.rs",
          "symbol": "fn alpha",
          "lines": null,
          "ref_key": "sym:src/a.rs\u0000fn alpha"
        }
      ]
    },
    {
      "id": "symbol.bad_lines_kept",
      "rule": "KR-SYN-5",
      "text": "[@ file=\"src/a.rs\" symbol=\"fn alpha\" lines=\"9-4\"]",
      "refs": [
        {
          "kind": "symbol",
          "path": "src/a.rs",
          "symbol": "fn alpha",
          "lines": null,
          "bad_lines": "9-4",
          "ref_key": "sym:src/a.rs\u0000fn alpha"
        }
      ]
    },
    {
      "id": "range.single",
      "rule": "KR-SYN-5",
      "text": "[@ file=\"src/a.rs\" lines=\"4\"] [@ file=\"src/a.rs\" lines=\"4-4\"]",
      "refs": [
        {
          "kind": "range",
          "path": "src/a.rs",
          "lines": "4",
          "ref_key": "range:src/a.rs\u00004"
        },
        {
          "kind": "range",
          "path": "src/a.rs",
          "lines": "4",
          "ref_key": "range:src/a.rs\u00004"
        }
      ]
    },
    {
      "id": "range.invalid_lines_kept",
      "rule": "KR-SYN-5",
      "text": "[@ file=\"a.rs\" lines=\"0-1\"] [@ file=\"b.rs\" lines=\"9-4\"] [@ file=\"c.rs\" lines=\"abc\"] [@ file=\"d.rs\" lines=\"3 - 5\"]",
      "refs": [
        {
          "kind": "range",
          "path": "a.rs",
          "lines": null,
          "bad_lines": "0-1",
          "ref_key": "range:a.rs\u00000-1"
        },
        {
          "kind": "range",
          "path": "b.rs",
          "lines": null,
          "bad_lines": "9-4",
          "ref_key": "range:b.rs\u00009-4"
        },
        {
          "kind": "range",
          "path": "c.rs",
          "lines": null,
          "bad_lines": "abc",
          "ref_key": "range:c.rs\u0000abc"
        },
        {
          "kind": "range",
          "path": "d.rs",
          "lines": null,
          "bad_lines": "3 - 5",
          "ref_key": "range:d.rs\u00003 - 5"
        }
      ]
    },
    {
      "id": "range.plus_sign_is_invalid",
      "rule": "KR-SYN-5",
      "text": "[@ file=\"a.rs\" lines=\"+3\"]",
      "refs": [
        {
          "kind": "range",
          "path": "a.rs",
          "lines": null,
          "bad_lines": "+3",
          "ref_key": "range:a.rs\u0000+3"
        }
      ]
    },
    {
      "id": "range.overflow_is_invalid",
      "rule": "KR-SYN-5",
      "text": "[@ file=\"a.rs\" lines=\"4294967296\"]",
      "refs": [
        {
          "kind": "range",
          "path": "a.rs",
          "lines": null,
          "bad_lines": "4294967296",
          "ref_key": "range:a.rs\u00004294967296"
        }
      ],
      "frontend": "F6: TS Number() accepts values above u32::MAX."
    },
    {
      "id": "code.fences_hidden",
      "rule": "KR-SYN-6",
      "text": "```\n[@ key=\"a\"]\n```\n~~~\n[@ key=\"b\"]\n~~~\n````\n```\n[@ key=\"c\"]\n````\n[@ key=\"d\"]",
      "refs": [
        {
          "kind": "node",
          "key": "d",
          "ref_key": "node:d"
        }
      ]
    },
    {
      "id": "code.indented_four_is_not_a_fence",
      "rule": "KR-SYN-6",
      "text": "    ```\n[@ key=\"a\"]",
      "refs": [
        {
          "kind": "node",
          "key": "a",
          "ref_key": "node:a"
        }
      ]
    },
    {
      "id": "code.unclosed_fence_hides_rest",
      "rule": "KR-SYN-6",
      "text": "[@ key=\"a\"]\n```\n[@ key=\"b\"]",
      "refs": [
        {
          "kind": "node",
          "key": "a",
          "ref_key": "node:a"
        }
      ]
    },
    {
      "id": "code.inline_hidden",
      "rule": "KR-SYN-6",
      "text": "`[@ key=\"a\"]` ``x [@ key=\"b\"] y`` [@ key=\"c\"]",
      "refs": [
        {
          "kind": "node",
          "key": "c",
          "ref_key": "node:c"
        }
      ]
    },
    {
      "id": "code.unclosed_backtick_is_prose",
      "rule": "KR-SYN-6",
      "text": "` [@ key=\"a\"]",
      "refs": [
        {
          "kind": "node",
          "key": "a",
          "ref_key": "node:a"
        }
      ]
    },
    {
      "id": "order.mixed_and_repeats",
      "rule": "KR-SYN-8",
      "text": "[@ file=\"b.rs\"] then [@ key=\"x\"] and [@ file=\"a.rs\" symbol=\"fn a\"]\n[@ key=\"x\"]",
      "refs": [
        {
          "kind": "file",
          "path": "b.rs",
          "ref_key": "file:b.rs"
        },
        {
          "kind": "node",
          "key": "x",
          "ref_key": "node:x"
        },
        {
          "kind": "symbol",
          "path": "a.rs",
          "symbol": "fn a",
          "lines": null,
          "ref_key": "sym:a.rs\u0000fn a"
        },
        {
          "kind": "node",
          "key": "x",
          "ref_key": "node:x"
        }
      ]
    },
    {
      "id": "range.other_invalid_forms",
      "rule": "KR-SYN-5",
      "text": "[@ file=\"a.rs\" lines=\"04\"] [@ file=\"a.rs\" lines=\"1-\"] [@ file=\"a.rs\" lines=\"-3\"] [@ file=\"a.rs\" lines=\"0\"] [@ file=\"a.rs\" lines=\" 3\"] [@ file=\"a.rs\" lines=\"1-2-3\"] [@ file=\"a.rs\" lines=\"３\"]",
      "refs": [
        {
          "kind": "range",
          "path": "a.rs",
          "lines": null,
          "bad_lines": "04",
          "ref_key": "range:a.rs\u000004"
        },
        {
          "kind": "range",
          "path": "a.rs",
          "lines": null,
          "bad_lines": "1-",
          "ref_key": "range:a.rs\u00001-"
        },
        {
          "kind": "range",
          "path": "a.rs",
          "lines": null,
          "bad_lines": "-3",
          "ref_key": "range:a.rs\u0000-3"
        },
        {
          "kind": "range",
          "path": "a.rs",
          "lines": null,
          "bad_lines": "0",
          "ref_key": "range:a.rs\u00000"
        },
        {
          "kind": "range",
          "path": "a.rs",
          "lines": null,
          "bad_lines": " 3",
          "ref_key": "range:a.rs\u0000 3"
        },
        {
          "kind": "range",
          "path": "a.rs",
          "lines": null,
          "bad_lines": "1-2-3",
          "ref_key": "range:a.rs\u00001-2-3"
        },
        {
          "kind": "range",
          "path": "a.rs",
          "lines": null,
          "bad_lines": "３",
          "ref_key": "range:a.rs\u0000３"
        }
      ]
    },
    {
      "id": "range.u32_max_is_valid",
      "rule": "KR-SYN-5",
      "text": "[@ file=\"a.rs\" lines=\"4294967295\"]",
      "refs": [
        {
          "kind": "range",
          "path": "a.rs",
          "lines": "4294967295",
          "ref_key": "range:a.rs\u00004294967295"
        }
      ]
    },
    {
      "id": "ref_key.path_normalized",
      "rule": "KR-KEY-1",
      "text": "[@ file=\" src\\a.rs \"] [@ file=\"src\\a.rs\" symbol=\" impl S › fn x \"] [@ file=\"src\\a.rs\" lines=\"7-7\"]",
      "refs": [
        {
          "kind": "file",
          "path": "src/a.rs",
          "ref_key": "file:src/a.rs"
        },
        {
          "kind": "symbol",
          "path": "src/a.rs",
          "symbol": "impl S › fn x",
          "lines": null,
          "ref_key": "sym:src/a.rs\u0000impl S › fn x"
        },
        {
          "kind": "range",
          "path": "src/a.rs",
          "lines": "7",
          "ref_key": "range:src/a.rs\u00007"
        }
      ]
    }
  ],
  "resolve": [
    {
      "id": "node.ok",
      "rule": "KR-NODE-1",
      "nodes": [
        {
          "key": "a",
          "body": "[@ key=\"b\"]"
        },
        {
          "key": "b",
          "body": ""
        }
      ],
      "expect": []
    },
    {
      "id": "node.dangling",
      "rule": "KR-NODE-1",
      "nodes": [
        {
          "key": "a",
          "body": "[@ key=\"gone\"] [@ key=\"gone\"]"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "dangling_relation",
          "ref_key": "node:gone"
        }
      ]
    },
    {
      "id": "node.case_sensitive",
      "rule": "KR-NODE-1",
      "nodes": [
        {
          "key": "a",
          "body": "[@ key=\"Seq\"]"
        },
        {
          "key": "seq",
          "body": ""
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "dangling_relation",
          "ref_key": "node:Seq"
        }
      ]
    },
    {
      "id": "node.self",
      "rule": "KR-NODE-2",
      "nodes": [
        {
          "key": "a",
          "body": "[@ key=\"a\"]"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "self_relation",
          "ref_key": "node:a"
        }
      ]
    },
    {
      "id": "node.inactive_target",
      "rule": "KR-NODE-3",
      "nodes": [
        {
          "key": "a",
          "body": "[@ key=\"off\"] [@ key=\"draft\"]"
        },
        {
          "key": "off",
          "status": "disabled",
          "body": ""
        },
        {
          "key": "draft",
          "status": "pending",
          "body": ""
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "inactive_target",
          "ref_key": "node:off"
        },
        {
          "node": "a.md",
          "status": "inactive_target",
          "ref_key": "node:draft"
        }
      ]
    },
    {
      "id": "node.inactive_citer_is_quiet",
      "rule": "KR-NODE-3",
      "nodes": [
        {
          "key": "a",
          "status": "disabled",
          "body": "[@ key=\"off\"]"
        },
        {
          "key": "p",
          "status": "pending",
          "body": "[@ key=\"off\"]"
        },
        {
          "key": "off",
          "status": "disabled",
          "body": ""
        }
      ],
      "expect": []
    },
    {
      "id": "node.code_is_not_a_citation",
      "rule": "KR-SYN-6",
      "nodes": [
        {
          "key": "a",
          "body": "```\n[@ key=\"gone\"]\n```\n`[@ file=\"nope.rs\"]`"
        }
      ],
      "expect": []
    },
    {
      "id": "node.duplicate_target_resolves_first",
      "rule": "KR-NODE-4",
      "nodes": [
        {
          "key": "dup",
          "path": "x/dup.md",
          "body": ""
        },
        {
          "key": "dup",
          "path": "y/dup.md",
          "body": ""
        },
        {
          "key": "c",
          "body": "[@ key=\"dup\"]"
        }
      ],
      "expect": [
        {
          "node": "x/dup.md",
          "status": "duplicate_key",
          "ref": "dup"
        },
        {
          "node": "y/dup.md",
          "status": "duplicate_key",
          "ref": "dup"
        }
      ]
    },
    {
      "id": "file.ok",
      "rule": "KR-PATH-3",
      "files": {
        "src/a.rs": "fn alpha() {}\n"
      },
      "nodes": [
        {
          "key": "a",
          "body": "[@ file=\"src/a.rs\"] [@ file=\"src/a.rs\"]"
        }
      ],
      "expect": []
    },
    {
      "id": "file.directory_ok",
      "rule": "KR-PATH-3",
      "files": {
        "src/a.rs": ""
      },
      "dirs": [
        "empty"
      ],
      "nodes": [
        {
          "key": "a",
          "body": "[@ file=\"src\"] [@ file=\"empty\"]"
        }
      ],
      "expect": []
    },
    {
      "id": "file.missing",
      "rule": "KR-PATH-3",
      "nodes": [
        {
          "key": "a",
          "body": "[@ file=\"src/gone.rs\"] [@ file=\"src/gone.rs\"]"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "file:src/gone.rs"
        }
      ]
    },
    {
      "id": "file.moved_is_missing",
      "rule": "KR-PATH-5",
      "files": {
        "src/new.rs": "fn alpha() {}\n"
      },
      "nodes": [
        {
          "key": "a",
          "body": "[@ file=\"src/old.rs\"]"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "file:src/old.rs"
        }
      ]
    },
    {
      "id": "file.illegal_paths",
      "rule": "KR-PATH-1",
      "files": {
        "src/a.rs": ""
      },
      "nodes": [
        {
          "key": "a",
          "body": "[@ file=\"../x\"] [@ file=\"/etc/passwd\"] [@ file=\"C:/x\"] [@ file=\"src/../src/a.rs\"] [@ file=\"./src/a.rs\"] [@ file=\"src//a.rs\"] [@ file=\"src/\"]"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "file:../x"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "file:/etc/passwd"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "file:C:/x"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "file:src/../src/a.rs"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "file:./src/a.rs"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "file:src//a.rs"
        },
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "file:src/"
        }
      ]
    },
    {
      "id": "file.backslash_normalized",
      "rule": "KR-PATH-2",
      "files": {
        "src/a.rs": ""
      },
      "nodes": [
        {
          "key": "a",
          "body": "[@ file=\"src\\a.rs\"]"
        }
      ],
      "expect": []
    },
    {
      "id": "file.gitignored_exists",
      "rule": "KR-PATH-3",
      "files": {
        ".gitignore": "ignored/\n",
        "ignored/x.txt": "x"
      },
      "nodes": [
        {
          "key": "a",
          "body": "[@ file=\"ignored/x.txt\"]"
        }
      ],
      "expect": [],
      "frontend": "F1: existence via the Explorer listing hides gitignored / files.exclude entries."
    },
    {
      "id": "file.dotfiles_exist",
      "rule": "KR-PATH-3",
      "files": {
        ".env": "A=1",
        ".config/x.toml": ""
      },
      "nodes": [
        {
          "key": "a",
          "body": "[@ file=\".env\"] [@ file=\".config/x.toml\"]"
        }
      ],
      "expect": []
    },
    {
      "id": "file.unicode_and_spaces",
      "rule": "KR-PATH-3",
      "files": {
        "文档/设计 说明.md": "x"
      },
      "nodes": [
        {
          "key": "a",
          "body": "[@ file=\"文档/设计 说明.md\"]"
        }
      ],
      "expect": []
    },
    {
      "id": "file.case_mismatch_dir",
      "rule": "KR-PATH-4",
      "files": {
        "src/a.rs": ""
      },
      "nodes": [
        {
          "key": "a",
          "body": "[@ file=\"SRC/a.rs\"]"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "file:SRC/a.rs"
        }
      ],
      "frontend": "F2: name compare is case-insensitive on every platform."
    },
    {
      "id": "file.case_mismatch_name",
      "rule": "KR-PATH-4",
      "files": {
        "src/a.rs": ""
      },
      "nodes": [
        {
          "key": "a",
          "body": "[@ file=\"src/A.rs\"]"
        }
      ],
      "expect": [
        {
          "node": "a.md",
          "status": "missing_file",
          "ref_key": "file:src/A.rs"
        }
      ],
      "frontend": "F2"
    },
    {
      "id": "file.trailing_dot",
      "rule": "KR-PATH-4",
      "files": {
        "src/a.rs": ""
      },
      "nodes": [
        {
          "key": "a",
          "body": "[@ file=\"src/a.rs.\"]"
        }
      ],
      "expect": [
