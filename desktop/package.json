{
  "name": "litecode-desktop",
  "version": "0.2.4",
  "private": true,
  "description": "Litecode Electron host (sidecar + BrowserWindow)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-theme-tokens.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "tsc -p tsconfig.json && node ./scripts/copy-theme-tokens.mjs && node --test dist/*.test.js",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "pack:dir": "npm run build && electron-builder --win dir --x64"
  },
  "build": {
    "appId": "app.litecode.desktop",
    "productName": "Litecode",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/product",
        "to": "sidecar",
        "filter": [
          "**/*",
          "!models/**"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Litecode-${version}-${os}-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Litecode-Setup-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "electron-winstaller@5.4.0": true
  }
}
