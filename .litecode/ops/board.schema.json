{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "litecode-ops-board.schema.json",
  "title": "LiteCode Ops Board",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "domains",
    "agents",
    "work_packages",
    "pipelines"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "goal",
          "baseline"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": "string",
            "minLength": 1
          },
          "owner_agent": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "place",
          "scope",
          "tools",
          "accept_tests",
          "reject_tests",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "place": {
            "type": "string"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accept_tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reject_tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "active",
              "standby",
              "fired"
            ]
          },
          "node": {
            "type": [
              "string",
              "null"
            ],
            "description": "所属组织节点 id（WP-189）"
          },
          "superior": {
            "type": [
              "string",
              "null"
            ],
            "description": "直接上级 agent id 或 andy；由 org-sync 或手填，validate 抓漂移"
          },
          "subordinates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "直接下级 id 列表"
          }
        }
      }
    },
    "work_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "title",
          "result",
          "done_when",
          "owner",
          "reviewer",
          "status",
          "depends_on",
          "blocker"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WP-[0-9]{3,}$"
          },
          "domain": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "done_when": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "drafting",
              "awaiting_approval",
              "backlog",
              "ready",
              "in_progress",
              "review",
              "done",
              "blocked",
              "cancelled"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocker": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "kind",
              "note"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "product",
                  "architecture",
                  "other"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          },
          "handoff_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "progress": {
            "type": "string"
          },
          "status_entered_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO8601 when WP last entered in_progress, review or awaiting_approval (v13); null otherwise"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "description": "v13: parent WP id; null/absent = top-level"
          },
          "goal": {
            "type": "string",
            "description": "v13: goal given by the parent level"
          },
          "approver": {
            "type": [
              "string",
              "null"
            ],
            "description": "v13: upper-level approver (agent id or andy); falls back to reviewer"
          },
          "content": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "kind",
              "text"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "direct",
                  "split"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          },
          "history": {
            "type": "array",
            "description": "v13: append-only approval history",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ts",
                "actor",
                "action"
              ],
              "properties": {
                "ts": {
                  "type": "string"
                },
                "actor": {
                  "type": "string"
                },
                "action": {
                  "enum": [
                    "create",
                    "fill",
                    "submit",
                    "approve",
                    "start",
                    "deliver",
                    "reject",
                    "return",
                    "reopen",
                    "close",
                    "set",
                    "reassign",
                    "handle",
                    "forward"
                  ]
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "direct",
              "split",
              "request"
            ],
            "description": "WP 包类型；缺省=普通包。与 content.kind 无关"
          },
          "requester": {
            "type": [
              "string",
              "null"
            ],
            "description": "kind=request 时发起人"
          }
        }
      }
    },
    "pipelines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "owner",
          "reviewer",
          "work_packages",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "work_packages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "idle",
              "running",
              "blocked",
              "done"
            ]
          }
        }
      }
    },
    "org_nodes": {
      "type": "array",
      "description": "组织树节点（WP-189）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "parent",
          "lead"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "lead": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string"
          }
        }
      }
    },
    "ops_config": {
      "type": "object",
      "additionalProperties": false,
      "description": "ops 运行时配置（WP-189）",
      "properties": {
        "principal": {
          "type": "string"
        },
        "intake_agent": {
          "type": "string"
        },
        "escalate_to_principal": {
          "type": "boolean"
        }
      }
    }
  }
}
