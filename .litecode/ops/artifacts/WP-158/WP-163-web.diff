+import type { ReactNode } from "react";
+import { Plus, Trash } from "@phosphor-icons/react";
+
+import type { ToolScope } from "../../../api/settings";
+import { FoldCard } from "../../../components/FoldCard";
+import { Dropdown, dropdownItemClass } from "../../../components/ui/Dropdown";
+import { SettingsPageShell } from "./shared";
+
+/** Shared scope hint for definition pages (W-C4 / W-C6). Each page keeps its
+ *  original wording: `bindFirst` renders "Bind on Agents. Workspace overrides
+ *  global." (Custom Tools); otherwise "Workspace overrides global. Bind
+ *  <bindName> on Agents." (MCP). */
+export function ScopeHint({
+  bindName,
+  bindFirst = false,
+}: {
+  bindName?: ReactNode;
+  bindFirst?: boolean;
+}) {
+  if (bindFirst) {
+    return (
+      <p className="text-xs text-(--_dk-text-muted)">
+        Bind on Agents. Workspace overrides global.
+      </p>
+    );
+  }
+  return (
+    <p className="text-xs text-(--_dk-text-muted)">
+      Workspace overrides global. Bind
+      {bindName ? (
+        <>
+          {" "}
+          <span className="font-mono">{bindName}</span>
+        </>
+      ) : null}{" "}
+      on Agents.
+    </p>
+  );
+}
+
+interface ScopedDefinitionEditorProps<T> {
+  title: string;
+  /** Label of the "+" button, e.g. "New MCP server". */
+  newLabel: string;
+  hint: ReactNode;
+  global: readonly T[];
+  workspace: readonly T[];
+  itemId: (item: T) => string;
+  /** Muted right-hand summary on each row (command, status …). */
+  itemSummary: (item: T) => ReactNode;
+  /** Disables Create / New / Delete (save blocked or persist busy). */
+  actionsDisabled: boolean;
+  isNew: boolean;
+  createScope: ToolScope;
+  selectedScope: ToolScope;
+  selectedId: string | null;
+  onCreate: () => void;
+  onStartCreate: (scope: ToolScope) => void;
+  onCancelNew: () => void;
+  onOpen: (scope: ToolScope, id: string) => void;
+  onClose: () => void;
+  onDelete: (id: string, scope: ToolScope) => void;
+  /** Form shown inside the open (or new) definition card. */
+  editorForm: ReactNode;
+}
+
+/**
+ * Global/workspace definition list with a JSON editor card, shared by the
+ * Custom Tools and MCP settings pages. Each page owns its own form and
+ * persistence; this owns the page shell, scope groups and row chrome.
+ */
+export function ScopedDefinitionEditor<T>({
+  title,
+  newLabel,
+  hint,
+  global,
+  workspace,
+  itemId,
+  itemSummary,
+  actionsDisabled,
+  isNew,
+  createScope,
+  selectedScope,
+  selectedId,
+  onCreate,
+  onStartCreate,
+  onCancelNew,
+  onOpen,
+  onClose,
+  onDelete,
+  editorForm,
+}: ScopedDefinitionEditorProps<T>) {
+  return (
+    <SettingsPageShell
+      title={title}
+      actions={
+        <>
+          {isNew ? (
+            <button
+              type="button"
+              className="btn-primary btn-sm"
+              disabled={actionsDisabled}
+              onClick={onCreate}
+            >
+              Create
+            </button>
+          ) : null}
+          <Dropdown
+            variant="menu"
+            align="right"
+            panelClassName="rounded-md"
+            trigger={({ open, toggle }) => (
+              <button
+                type="button"
+                className="btn btn-icon"
+                disabled={actionsDisabled}
+                aria-label={newLabel}
+                aria-haspopup="menu"
+                aria-expanded={open}
+                title={newLabel}
+                onClick={toggle}
+              >
+                <Plus size={16} />
+              </button>
+            )}
+          >
+            <button
+              type="button"
+              className={dropdownItemClass}
+              onClick={() => onStartCreate("global")}
+            >
+              Global
+            </button>
+            <button
+              type="button"
+              className={dropdownItemClass}
+              onClick={() => onStartCreate("workspace")}
+            >
+              Workspace
+            </button>
+          </Dropdown>
+        </>
+      }
+    >
+      <div className="space-y-4">
+        {hint}
+        <div className="space-y-3">
+          {(
+            [
+              ["global", global, "Global"],
+              ["workspace", workspace, "Workspace"],
+            ] as const
+          ).map(([scope, list, groupTitle]) => (
+            <FoldCard
+              key={scope}
+              defaultOpen
+              label={
+                <span className="settings-section-title">{groupTitle}</span>
+              }
+              className="settings-foldcard"
+            >
+              <div className="space-y-2">
+                {list.length === 0 && !(isNew && createScope === scope) ? (
+                  <p className="px-2 py-3 text-xs text-(--_dk-text-muted)">
+                    None.
+                  </p>
+                ) : null}
+                {list.map((item) => {
+                  const id = itemId(item);
+                  const selected =
+                    !isNew && selectedScope === scope && selectedId === id;
+                  return (
+                    <FoldCard
+                      key={`${scope}:${id}`}
+                      open={selected}
+                      onToggle={(o) => {
+                        if (o) onOpen(scope, id);
+                        else if (selectedScope === scope && selectedId === id)
+                          onClose();
+                      }}
+                      label={
+                        <span className="flex flex-1 items-center justify-between gap-2">
+                          <span className="font-mono text-sm text-(--_dk-text-secondary)">
+                            {id}
+                          </span>
+                          <span className="flex items-center gap-2">
+                            <span className="truncate text-xs text-(--_dk-text-muted)">
+                              {itemSummary(item)}
+                            </span>
+                            <button
+                              type="button"
+                              className="btn-danger btn-icon"
+                              disabled={actionsDisabled}
+                              onClick={(e) => {
+                                e.stopPropagation();
+                                onDelete(id, scope);
+                              }}
+                              onKeyDown={(e) => e.stopPropagation()}
+                              aria-label={`Delete ${id}`}
+                              title={`Delete ${id}`}
+                            >
+                              <Trash size={16} />
+                            </button>
+                          </span>
+                        </span>
+                      }
+                      className="settings-foldcard"
+                    >
+                      {selected ? editorForm : null}
+                    </FoldCard>
+                  );
+                })}
+                {isNew && createScope === scope ? (
+                  <FoldCard
+                    key="__new"
+                    open
+                    onToggle={(o) => {
+                      if (!o) onCancelNew();
+                    }}
+                    label={
+                      <span className="font-mono text-sm text-(--_dk-text-secondary)">
+                        (new)
+                      </span>
+                    }
+                    className="settings-foldcard"
+                  >
+                    {editorForm}
+                  </FoldCard>
+                ) : null}
+              </div>
+            </FoldCard>
+          ))}
+        </div>
+      </div>
+    </SettingsPageShell>
+  );
+}
diff --git a/web/src/dockview/panels/useSessionPanelBootstrap.ts b/web/src/dockview/panels/useSessionPanelBootstrap.ts
new file mode 100644
index 0000000..e236a5e
--- /dev/null
+++ b/web/src/dockview/panels/useSessionPanelBootstrap.ts
@@ -0,0 +1,69 @@
+import { useEffect, useState } from "react";
+import type { DockviewPanelApi } from "dockview-react";
+
+import type { SessionInfo } from "../../api/types";
+import { releaseSessionTab } from "../../components/sessionTeardown";
+import { useConnectionStore } from "../../stores/connectionStore";
+import { useSessionStore } from "../../stores/sessionStore";
+import { useToastStore } from "../../stores/toastStore";
+
+/**
+ * Connection lifecycle shared by the session dock panels (writable
+ * `AgentPanel` and read-only `SubagentReadOnlyPanel`):
+ * - tracks the dockview active state;
+ * - (re)subscribes on every transition to "connected", including reconnects,
+ *   so a dropped subscription self-heals;
+ * - closes the panel with a toast when the session no longer exists (any
+ *   other failure waits for the next "connected" transition);
+ * - releases the subscription and local projection only on real unmount.
+ * Returns the active flag plus the session's list entry and trimmed preview.
+ */
+export function useSessionPanelBootstrap(
+  api: DockviewPanelApi,
+  sessionId: string,
+): { isActive: boolean; session: SessionInfo | undefined; preview: string } {
+  const connState = useConnectionStore((s) => s.state);
+  const [isActive, setIsActive] = useState(api.isActive);
+
+  useEffect(() => {
+    const d = api.onDidActiveChange((e) => setIsActive(e.isActive));
+    return () => d.dispose();
+  }, [api]);
+
+  useEffect(() => {
+    if (!sessionId || connState !== "connected") return;
+    let disposed = false;
+    useConnectionStore
+      .getState()
+      .ensureSubscribe(sessionId)
+      .catch((error: unknown) => {
+        if (disposed) return;
+        const message =
+          error instanceof Error ? error.message : "Failed to open session";
+        if (/session.*not found/i.test(message)) {
+          useToastStore
+            .getState()
+            .showToast("This session no longer exists", "error");
+          api.close();
+        }
+      });
+    return () => {
+      disposed = true;
+    };
+  }, [api, sessionId, connState]);
+
+  useEffect(() => {
+    if (!sessionId) return;
+    return () => {
+      releaseSessionTab(sessionId);
+    };
+  }, [sessionId]);
+
+  const preview = useSessionStore(
+    (s) => s.sessions.find((x) => x.id === sessionId)?.preview?.trim() ?? "",
+  );
+  const session = useSessionStore((s) =>
+    s.sessions.find((x) => x.id === sessionId),
+  );
+  return { isActive, session, preview };
+}
