# Thin per-task layer on a verified toolchain image: add grok-build if the
# toolchain (built earlier from Dockerfile.toolchain or a prior eval image)
# does not already carry it, then prove all five binaries resolve.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root

RUN if ! command -v grok >/dev/null 2>&1; then \
      curl -fsSL https://x.ai/cli/install.sh | bash; \
    fi \
 && test -x /root/.grok/bin/grok \
 && /root/.grok/bin/grok --version

RUN bash -lc 'set -e; \
  . /root/.nvm/nvm.sh; \
  codex --version; \
  pi --version; \
  opencode --version; \
  PATH="/root/.grok/bin:$PATH" grok --version'