# Canonical harness toolchain image for one Terminal-Bench task.
#
# FROM the task's pinned base, install Node 22 and the four non-LiteCode CLIs
# at fixed versions. The eval runner then adds the thin grok layer and points
# the copied dataset's task.toml at the result. Building this from scratch is
# the reproducible path; `Dockerfile.harness` is the fast path used when the
# toolchain image already exists.
#
# Arguments:
#   BASE_IMAGE       task image, e.g. alexgshaw/password-recovery:20251031
#   CODEX_VERSION    npm version of @openai/codex
#   PI_VERSION       npm version of @earendil-works/pi-coding-agent
#   OPENCODE_VERSION npm version of opencode-ai
#   GROK_VERSION     version passed to x.ai's installer (-s)
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root

# The task base may be Ubuntu 24.04 or Debian 12 (the cancel-async-tasks
# image is bookworm). Keep Debian's default sources; rewrite only Ubuntu's
# sources to the mirror used by the other eval images.
RUN if grep -qi '^ID=ubuntu' /etc/os-release; then \
      printf 'Types: deb\nURIs: http://mirrors.aliyun.com/ubuntu/\nSuites: noble noble-updates noble-backports\nComponents: main restricted universe multiverse\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n\nTypes: deb\nURIs: http://mirrors.aliyun.com/ubuntu/\nSuites: noble-security\nComponents: main restricted universe multiverse\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n' > /etc/apt/sources.list.d/ubuntu.sources; \
    fi \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash ca-certificates coreutils curl git procps ripgrep xz-utils \
 && rm -rf /var/lib/apt/lists/*

ARG CODEX_VERSION=0.167.2
ARG PI_VERSION=1.5.2
ARG OPENCODE_VERSION=1.19.5
ARG GROK_VERSION=1.0.77

ENV NVM_DIR=/root/.nvm \
    NVM_NODEJS_ORG_MIRROR=https://npmmirror.com/mirrors/node

RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.2/install.sh | bash \
 && . /root/.nvm/nvm.sh \
 && nvm install 22 \
 && nvm alias default 22 \
 && npm config set registry https://registry.npmmirror.com --global \
 && npm install -g \
      "@openai/codex@${CODEX_VERSION}" \
      "@earendil-works/pi-coding-agent@${PI_VERSION}" \
      "opencode-ai@${OPENCODE_VERSION}" \
 && npm cache clean --force

RUN curl -fsSL https://x.ai/cli/install.sh | bash -s "${GROK_VERSION}" \
 && /root/.grok/bin/grok --version

# Fail the image build, not a trial, if any CLI is missing or the wrong one.
RUN bash -lc 'set -e; \
  . /root/.nvm/nvm.sh; \
  test "$(codex --version | head -1)" = "codex-cli ${CODEX_VERSION}" || codex --version; \
  test "$(pi --version | head -1)" = "${PI_VERSION}" || pi --version; \
  test "$(opencode --version | head -1)" = "${OPENCODE_VERSION}" || opencode --version; \
  PATH="/root/.grok/bin:$PATH" grok --version'