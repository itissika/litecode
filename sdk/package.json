{
  "name": "litecode-run-code-sdk",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.28.5",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-contract.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.generated.json --noEmit && node scripts/generate-contract.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:generated": "tsc -p tsconfig.generated.json --noEmit"
  },
  "devDependencies": {
    "ts-json-schema-generator": "^2.9.0",
    "ts-morph": "^28.0.0",
    "typescript": "~5.8.3"
  }
}